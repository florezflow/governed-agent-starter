{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--browser",
        "chrome",
        "--allowed-origins",
        "http://localhost:4173",
        "--viewport-size",
        "1280x800",
        "--output-dir",
        "/tmp/playwright-mcp"
      ]
    }
  }
}
