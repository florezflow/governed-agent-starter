{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill",
      "Bash(node scripts/check-design.mjs)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_close",
      "Write(./site/**)",
      "Edit(./site/**)",
      "Write(./screenshots/**)",
      "Write(./.agent/**)",
      "Edit(./.agent/**)",
      "Bash(ls)",
      "Bash(ls *)",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_console_messages"
    ],
    "deny": [
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.mcp.json)",
      "Edit(/scripts/**)",
      "Edit(/hooks/**)",
      "Edit(/AGENTS.md)",
      "Read(.env)",
      "Read(**/.env.*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch",
      "WebSearch",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(./.git/**)",
      "Edit(./.git/**)",
      "Edit(./.gitignore)",
      "Edit(./.gitattributes)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(env)",
      "Bash(printenv *)",
      "mcp__github",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.mcp.json)",
      "Edit(./scripts/**)",
      "Edit(./hooks/**)",
      "Edit(./AGENTS.md)",
      "Edit(./site/**/*.js)",
      "Edit(./site/*.js)",
      "Bash(git diff --no-index *)",
      "Bash(git diff --output *)"
    ]
  }
}
