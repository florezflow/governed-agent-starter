{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill",
      "Bash(node scripts/check-design.mjs)",
      "Bash(git status)",
      "Bash(git diff *)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_close"
    ],
    "deny": [
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.mcp.json)",
      "Edit(/scripts/**)",
      "Read(.env)",
      "Read(**/.env.*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch",
      "WebSearch",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(./.git/**)",
      "Edit(./.git/**)",
      "Edit(./.gitignore)",
      "Edit(./.gitattributes)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(env)",
      "Bash(printenv *)",
      "mcp__github",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.mcp.json)",
      "Edit(./scripts/**)",
      "Edit(./site/**/*.js)",
      "Edit(./site/*.js)"
    ]
  }
}
